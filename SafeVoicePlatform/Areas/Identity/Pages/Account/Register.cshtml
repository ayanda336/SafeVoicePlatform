@page
@model RegisterModel
@{
    ViewData["Title"] = "Register - Safe Voice";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h2 class="mb-0">Create Your Account</h2>
                    <p class="mb-0 mt-2 small">Join Safe Voice to report safely and anonymously</p>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-7">
                            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="John Doe" />
                                    <label asp-for="Input.FullName">Full Name</label>
                                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                    <label asp-for="Input.Email">Email Address</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Department" class="form-control" autocomplete="organization" placeholder="Department" />
                                    <label asp-for="Input.Department">Department/Unit (Optional)</label>
                                    <span asp-validation-for="Input.Department" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <select asp-for="Input.SelectedRole" class="form-control" id="roleSelect">
                                        <option value="">-- Select a role --</option>
                                        @if (ViewData["Roles"] is IEnumerable<SelectListItem> roles)
                                        {
                                            foreach (var role in roles)
                                            {
                                                <option value="@role.Value">@role.Text</option>
                                            }
                                        }
                                    </select>
                                    <label asp-for="Input.SelectedRole">I am registering as</label>
                                    <span asp-validation-for="Input.SelectedRole" class="text-danger"></span>
                                </div>

                                <!-- Institution selection (shown only when InstitutionAdmin is selected) -->
                                <div class="form-floating mb-3" id="institutionDiv" style="display: none;">
                                    <select asp-for="Input.InstitutionId" class="form-control" id="institutionSelect">
                                        <option value="">-- Select an institution --</option>
                                        @if (ViewData["Institutions"] is IEnumerable<SelectListItem> institutions)
                                        {
                                            foreach (var inst in institutions)
                                            {
                                                <option value="@inst.Value">@inst.Text</option>
                                            }
                                        }
                                    </select>
                                    <label asp-for="Input.InstitutionId">Institution</label>
                                    <span asp-validation-for="Input.InstitutionId" class="text-danger"></span>
                                    <small class="form-text text-muted">Select the institution you represent as an administrator.</small>
                                </div>

                                <!-- Support Organization selection (shown only when SupportOrgStaff is selected) -->
                                <div class="form-floating mb-3" id="supportOrgDiv" style="display: none;">
                                    <select asp-for="Input.SupportOrgId" class="form-control" id="supportOrgSelect">
                                        <option value="">-- Select a support organization --</option>
                                        @if (ViewData["SupportOrgs"] is IEnumerable<SelectListItem> supportOrgs)
                                        {
                                            foreach (var org in supportOrgs)
                                            {
                                                <option value="@org.Value">@org.Text</option>
                                            }
                                        }
                                    </select>
                                    <label asp-for="Input.SupportOrgId">Support Organization</label>
                                    <span asp-validation-for="Input.SupportOrgId" class="text-danger"></span>
                                    <small class="form-text text-muted">Select the organization you work for.</small>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                    <label asp-for="Input.Password">Password</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                    <small class="form-text text-muted">Password must be at least 6 characters with uppercase, lowercase, and numbers.</small>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="confirm password" />
                                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>

                                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">
                                    <i class="bi bi-person-plus"></i> Register
                                </button>
                            </form>
                        </div>
                        <div class="col-md-5">
                            <div class="card bg-light border-0">
                                <div class="card-body">
                                    <h5 class="card-title text-primary">Why Register?</h5>
                                    <hr />
                                    <p>As a registered Safe Voice user, you can:</p>
                                    <ul class="list-unstyled">
                                        <li class="mb-2">✓ Submit and track reports securely</li>
                                        <li class="mb-2">✓ Access confidential resources</li>
                                        <li class="mb-2">✓ Connect with support services</li>
                                        <li class="mb-2">✓ Participate in wellbeing surveys</li>
                                        <li class="mb-2">✓ Receive updates on your reports</li>
                                    </ul>
                                    <hr />
                                    <div class="alert alert-info mb-0">
                                        <strong>🔒 Privacy Guaranteed</strong><br />
                                        <small>All reports can be made anonymously. Your identity and privacy are protected.</small>
                                    </div>
                                    <div class="mt-3 text-center">
                                        <small>Already have an account? <a asp-page="./Login" class="text-primary">Login here</a></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-muted text-center py-3 bg-light">
                    <small>Safe Voice - Your voice matters. Speak up safely.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('roleSelect');
            const institutionDiv = document.getElementById('institutionDiv');
            const supportOrgDiv = document.getElementById('supportOrgDiv');
            const institutionSelect = document.getElementById('institutionSelect');
            const supportOrgSelect = document.getElementById('supportOrgSelect');

            function updateConditionalFields() {
                const selectedRole = roleSelect.value;

                // Hide all conditional fields first
                institutionDiv.style.display = 'none';
                supportOrgDiv.style.display = 'none';

                // Remove required attributes
                if (institutionSelect) institutionSelect.required = false;
                if (supportOrgSelect) supportOrgSelect.required = false;

                // Show relevant field based on role
                if (selectedRole === 'InstitutionAdmin') {
                    institutionDiv.style.display = 'block';
                    if (institutionSelect) institutionSelect.required = true;
                } else if (selectedRole === 'SupportOrgStaff') {
                    supportOrgDiv.style.display = 'block';
                    if (supportOrgSelect) supportOrgSelect.required = true;
                }
            }

            // Add event listener
            if (roleSelect) {
                roleSelect.addEventListener('change', updateConditionalFields);
                // Call once on page load to handle any pre-selected value
                updateConditionalFields();
            }
        });
    </script>
}

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
    }

    .form-floating > .form-control,
    .form-floating > .form-select {
        height: calc(3.5rem + 2px);
        line-height: 1.25;
    }

    .form-floating > label {
        padding: 1rem 0.75rem;
    }

    .btn-primary {
        padding: 0.75rem;
        font-weight: 600;
        background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
        border: none;
        transition: transform 0.2s;
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            background: linear-gradient(135deg, #0052a3 0%, #003d7a 100%);
        }

    .alert-info {
        background-color: #e7f3ff;
        border-color: #b8daff;
        border-radius: 10px;
    }

    .card.bg-light {
        background-color: #f8f9fa !important;
        border-radius: 10px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0066cc;
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.25);
    }
</style>