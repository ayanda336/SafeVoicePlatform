@model List<SafeVoicePlatform.Models.SupportOrganization>

@{
    ViewData["Title"] = "Manage Support Organizations";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Manage Support Organizations</h1>
        <div>
            <a asp-action="CreateSupportOrganization" class="btn btn-success me-2">
                <i class="bi bi-plus-circle"></i> Add Organization
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Phone</th>
                            <th>24/7</th>
                            <th>Free</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                    </thead>
                    <tbody>
                        @foreach (var org in Model)
                        {
                            <tr>
                                <td>@org.Id</td>
                                <td>@org.Name</td>
                                <td>@org.OrganizationType</td>
                                <td>@org.PhoneNumber</td>
                                <td>
                                    @if (org.Is247Available)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    @if (org.IsFreeService)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">No</span>
                                    }
                                </td>
                                <td>
                                    @if (org.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>@org.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a asp-action="EditSupportOrganization" asp-route-id="@org.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>