@model SafeVoicePlatform.Models.InstitutionDashboardViewModel

@{
    ViewData["Title"] = "Institution Dashboard";
    var typeLabels = Model.ReportsByType.Keys.ToList();
    var typeData = Model.ReportsByType.Values.ToList();
    var monthLabels = Model.MonthlyTrend.Keys.ToList();
    var monthData = Model.MonthlyTrend.Values.ToList();
    var statusLabels = Model.StatusDistribution.Select(s => s.Status).ToList();
    var statusData = Model.StatusDistribution.Select(s => s.Count).ToList();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-semibold mb-1">Institution Dashboard</h1>
            @if (Model.Institution != null)
            {
                <p class="text-muted mb-0">@Model.Institution.Name - @Model.Institution.Type</p>
            }
        </div>
        <div>
            <a asp-action="InstitutionReports" class="btn btn-outline-primary me-2">
                <i class="bi bi-list-ul"></i> View All Reports
            </a>
            <a asp-action="Export" class="btn btn-outline-success">
                <i class="bi bi-download"></i> Export Reports
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Reports</h6>
                            <h2 class="fw-bold mb-0">@Model.TotalReports</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-file-text fs-4 text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Pending</h6>
                            <h2 class="fw-bold mb-0">@Model.PendingReports</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-clock-history fs-4 text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Under Review</h6>
                            <h2 class="fw-bold mb-0">@Model.UnderReviewReports</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-eye fs-4 text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Resolved</h6>
                            <h2 class="fw-bold mb-0">@Model.ResolvedReports</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-check-circle fs-4 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Urgent Reports</h6>
                            <h2 class="fw-bold mb-0 text-danger">@Model.UrgentReports</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-exclamation-triangle fs-4 text-danger"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-3">
                    <h6 class="fw-semibold mb-0">Reports by Type</h6>
                </div>
                <div class="card-body">
                    <canvas id="reportsByTypeChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-3">
                    <h6 class="fw-semibold mb-0">Monthly Trend</h6>
                </div>
                <div class="card-body">
                    <canvas id="monthlyTrendChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Reports Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 pt-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-semibold mb-0">Recent Reports</h6>
            <a asp-action="InstitutionReports" class="btn btn-sm btn-link">View All</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-muted">
                            <th class="px-4 py-3">ID</th>
                            <th class="py-3">Type</th>
                            <th class="py-3">Title</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Date</th>
                            <th class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.RecentReports)
                        {
                            <tr class="border-bottom">
                                <td class="px-4">#@report.Id</td>
                                <td class="small">@report.ReportType</td>
                                <td class="fw-medium">@report.Title</td>
                                <td>
                                    @if (report.Status == "Resolved")
                                    {
                                        <span class="badge bg-success px-3 py-1">@report.Status</span>
                                    }
                                    else if (report.Status == "Under Review")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-1">@report.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-1">@report.Status</span>
                                    }
                                </td>
                                <td class="small text-muted">@report.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@report.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var typeLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(typeLabels));
        var typeData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(typeData));
        var monthLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(monthLabels));
        var monthData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(monthData));

        // Reports by Type Chart
        var typeCtx = document.getElementById('reportsByTypeChart').getContext('2d');
        new Chart(typeCtx, {
            type: 'bar',
            data: {
                labels: typeLabels,
                datasets: [{
                    label: 'Number of Reports',
                    data: typeData,
                    backgroundColor: 'rgba(54, 162, 235, 0.5)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // Monthly Trend Chart
        var trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Reports per Month',
                    data: monthData,
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 2,
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}