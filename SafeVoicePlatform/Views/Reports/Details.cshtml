@model SafeVoicePlatform.Models.Report

@{
    ViewData["Title"] = "Report Details";
    var currentStatus = Model.Status;
    var hasReferral = ViewBag.HasReferral == true;
    var referralStatus = ViewBag.ReferralStatus as string;
    var referralOrganization = ViewBag.ReferralOrganization as string;
    var referralNotes = ViewBag.ReferralNotes as string;
    var referralDate = ViewBag.ReferralDate as string;
    var referralId = ViewBag.ReferralId as int?;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <!-- Main Report Card -->
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">Report Details</h3>
                        @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                        {
                            <small class="text-white-50">Reference: @Model.ReferenceNumber</small>
                        }
                    </div>
                    <span class="badge fs-6 px-3 py-2
                        @(currentStatus == "Resolved" ? "bg-success" :
                                                    currentStatus == "Under Review" ? "bg-warning text-dark" : "bg-secondary")">
                        @Model.Status
                    </span>
                </div>
                <div class="card-body">
                    @if (Model.IsUrgent)
                    {
                        <div class="alert alert-danger mb-4">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>URGENT:</strong> This report has been marked as urgent and requires immediate attention.
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">Report Type</dt>
                        <dd class="col-sm-9">@Model.ReportType</dd>

                        <dt class="col-sm-3 fw-bold">Title</dt>
                        <dd class="col-sm-9">@Model.Title</dd>

                        <dt class="col-sm-3 fw-bold">Description</dt>
                        <dd class="col-sm-9">
                            <div class="bg-light p-3 rounded" style="white-space: pre-wrap;">
                                @Model.Description
                            </div>
                        </dd>

                        @if (Model.IncidentDate.HasValue)
                        {
                            <dt class="col-sm-3 fw-bold">Incident Date</dt>
                            <dd class="col-sm-9">@Model.IncidentDate.Value.ToString("dddd, MMMM dd, yyyy")</dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.Location))
                        {
                            <dt class="col-sm-3 fw-bold">Location</dt>
                            <dd class="col-sm-9">@Model.Location</dd>
                        }

                        <dt class="col-sm-3 fw-bold">Submitted On</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("dddd, MMMM dd, yyyy HH:mm tt")</dd>

                        @if (Model.UpdatedAt.HasValue)
                        {
                            <dt class="col-sm-3 fw-bold">Last Updated</dt>
                            <dd class="col-sm-9">@Model.UpdatedAt.Value.ToString("dddd, MMMM dd, yyyy HH:mm tt")</dd>
                        }

                        @if (Model.IsUrgent)
                        {
                            <dt class="col-sm-3 fw-bold">Priority</dt>
                            <dd class="col-sm-9"><span class="badge bg-danger">Urgent</span></dd>
                        }

                        @if (Model.IsAnonymous)
                        {
                            <dt class="col-sm-3 fw-bold">Reporting Type</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-info">Anonymous Report</span>
                                <small class="text-muted d-block mt-1">Your identity is protected. Use reference number to track this report.</small>
                            </dd>
                        }
                        else
                        {
                            <dt class="col-sm-3 fw-bold">Reporting Type</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-success">Identified Report</span>
                            </dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.WitnessInfo))
                        {
                            <dt class="col-sm-3 fw-bold">Witness Information</dt>
                            <dd class="col-sm-9">
                                <div class="bg-light p-3 rounded">
                                    @Model.WitnessInfo
                                </div>
                            </dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.AdminNotes))
                        {
                            <dt class="col-sm-3 fw-bold">Admin Notes</dt>
                            <dd class="col-sm-9">
                                <div class="bg-info bg-opacity-10 p-3 rounded border-start border-info border-4">
                                    @Model.AdminNotes
                                </div>
                            </dd>
                        }
                    </dl>

                    <!-- Attachments Section -->
                    @if (Model.Attachments != null && Model.Attachments.Any())
                    {
                        <hr />
                        <h5><i class="bi bi-paperclip"></i> Attachments</h5>
                        <div class="row mt-3">
                            @foreach (var attachment in Model.Attachments)
                            {
                                <div class="col-md-4 mb-2">
                                    <div class="card bg-light">
                                        <div class="card-body p-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    @if (attachment.FileType.StartsWith("image/"))
                                                    {
                                                        <i class="bi bi-file-image text-primary"></i>
                                                    }
                                                    else if (attachment.FileType == "application/pdf")
                                                    {
                                                        <i class="bi bi-file-pdf text-danger"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-file-text text-secondary"></i>
                                                    }
                                                    <small>@attachment.FileName</small>
                                                    <br />
                                                    <small class="text-muted">@(attachment.FileSize / 1024) KB</small>
                                                </div>
                                                <a href="/@attachment.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-download"></i> View
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between">
                        <div>
                            <a asp-action="MyReports" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                        @if (!Model.IsAnonymous && !string.IsNullOrEmpty(Model.ReferenceNumber))
                        {
                            <div>
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i> Reference number for tracking: <strong>@Model.ReferenceNumber</strong>
                                </small>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Status History Section -->
            @if (Model.StatusHistory != null && Model.StatusHistory.Any())
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Status History</h5>
                    </div>
                    <div class="card-body">
                        <div class="timeline">
                            @foreach (var history in Model.StatusHistory.OrderByDescending(h => h.ChangedAt))
                            {
                                <div class="mb-3 pb-2 border-bottom">
                                    <div class="d-flex">
                                        <div class="me-3">
                                            @if (history.Status == "Resolved")
                                            {
                                                <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                            }
                                            else if (history.Status == "Under Review")
                                            {
                                                <i class="bi bi-eye-fill text-warning fs-4"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-hourglass-split text-secondary fs-4"></i>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong class="text-primary">@history.Status</strong>
                                                <small class="text-muted">@history.ChangedAt.ToString("MMM dd, yyyy HH:mm tt")</small>
                                            </div>
                                            @if (!string.IsNullOrEmpty(history.Comment))
                                            {
                                                <p class="mb-0 mt-1 text-muted">@history.Comment</p>
                                            }
                                            @if (!string.IsNullOrEmpty(history.ChangedBy))
                                            {
                                                <small class="text-muted">Updated by: @history.ChangedBy</small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Status Update Section (Only for InstitutionAdmin and ITAdmin) -->
            @if (User.IsInRole("InstitutionAdmin") || User.IsInRole("ITAdmin"))
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Update Report Status</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="UpdateStatus" asp-controller="Reports" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">New Status</label>
                                    <select name="status" class="form-select" required>
                                        @if (currentStatus == "Pending")
                                        {
                                            <option value="Pending" selected>Pending</option>
                                            <option value="Under Review">Under Review</option>
                                            <option value="Resolved">Resolved</option>
                                        }
                                        else if (currentStatus == "Under Review")
                                        {
                                            <option value="Pending">Pending</option>
                                            <option value="Under Review" selected>Under Review</option>
                                            <option value="Resolved">Resolved</option>
                                        }
                                        else
                                        {
                                            <option value="Pending">Pending</option>
                                            <option value="Under Review">Under Review</option>
                                            <option value="Resolved" selected>Resolved</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Comment (Optional)</label>
                                    <input type="text" name="comment" class="form-control" placeholder="Add a comment about this status change" />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-save"></i> Update Status
                                    </button>
                                </div>
                            </div>
                        </form>
                        <hr />
                        <div class="alert alert-info mt-3 mb-0">
                            <i class="bi bi-info-circle"></i>
                            <strong>Note:</strong> When you update the status, a comment will be added to the status history.
                        </div>
                    </div>
                </div>
            }

            <!-- Referral Section - Only for InstitutionAdmin and ITAdmin -->
            @if (User.IsInRole("InstitutionAdmin") || User.IsInRole("ITAdmin"))
            {
                <div class="card shadow">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-share"></i> Support Organization Referral</h5>
                    </div>
                    <div class="card-body">
                        @if (hasReferral)
                        {
                            <!-- Show existing referral -->
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> This report has been referred to a support organization.
                            </div>
                            <dl class="row">
                                <dt class="col-sm-3">Support Organization</dt>
                                <dd class="col-sm-9">@referralOrganization</dd>

                                <dt class="col-sm-3">Status</dt>
                                <dd class="col-sm-9">
                                    @if (referralStatus == "Completed")
                                    {
                                        <span class="badge bg-success">@referralStatus</span>
                                    }
                                    else if (referralStatus == "In Progress")
                                    {
                                        <span class="badge bg-info">@referralStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">@referralStatus</span>
                                    }
                                </dd>

                                @if (!string.IsNullOrEmpty(referralNotes))
                                {
                                    <dt class="col-sm-3">Referral Notes</dt>
                                    <dd class="col-sm-9">@referralNotes</dd>
                                }

                                <dt class="col-sm-3">Referred On</dt>
                                <dd class="col-sm-9">@referralDate</dd>
                            </dl>

                            @if (User.IsInRole("ITAdmin") && referralId.HasValue)
                            {
                                <div class="mt-2">
                                    <a asp-controller="SupportOrg" asp-action="ReferralDetails" asp-route-id="@referralId.Value" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> View Referral Details
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Show referral form -->
                            <form asp-action="CreateReferral" asp-controller="Reports" asp-route-reportId="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Select Support Organization</label>
                                        <select name="supportOrgId" class="form-select" required>
                                            <option value="">-- Select an organization --</option>
                                            @if (ViewBag.SupportOrganizations != null)
                                            {
                                                foreach (var org in ViewBag.SupportOrganizations)
                                                {
                                                    <option value="@org.Value">@org.Text</option>
                                                }
                                            }
                                        </select>
                                        <small class="form-text text-muted">Choose the organization that can best help with this case.</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Referral Notes (Optional)</label>
                                        <input type="text" name="notes" class="form-control" placeholder="Add any notes for the support organization" />
                                        <small class="form-text text-muted">Provide context to help the support organization understand the case.</small>
                                    </div>
                                    <div class="col-md-12">
                                        <button type="submit" class="btn btn-info">
                                            <i class="bi bi-share"></i> Create Referral
                                        </button>
                                    </div>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .timeline {
        max-height: 400px;
        overflow-y: auto;
    }

    .bg-opacity-10 {
        --bs-bg-opacity: 0.1;
    }

    .border-start {
        border-left-width: 4px !important;
    }

    .card {
        border-radius: 10px;
    }

    .card-header {
        border-bottom: 2px solid rgba(0,0,0,0.05);
    }

    .badge {
        font-size: 0.9rem;
        padding: 0.5rem 1rem;
    }

    dt {
        font-weight: 600;
        color: #495057;
    }

    dd {
        margin-bottom: 1rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0052a3 0%, #003d7a 100%);
            transform: translateY(-1px);
        }

    .btn-secondary:hover {
        transform: translateY(-1px);
    }

    .btn-info {
        background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%);
        border: none;
        color: white;
    }

        .btn-info:hover {
            background: linear-gradient(135deg, #0aa2c0 0%, #08809a 100%);
            transform: translateY(-1px);
            color: white;
        }

    .table-responsive {
        overflow-x: auto;
    }

    @@media (max-width: 768px) {
        .container {
            padding: 0.5rem;
        }

        .card-body {
            padding: 1rem;
        }

        dt, dd {
            font-size: 0.9rem;
        }
    }
</style>

@section Scripts {
    <script>
        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert-success, .alert-danger');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    alert.style.display = 'none';
                }, 5000);
            });
        }, 100);

        // Confirm status update
        var statusForm = document.querySelector('form[action*="UpdateStatus"]');
        if (statusForm) {
            statusForm.addEventListener('submit', function(e) {
                var newStatus = document.querySelector('select[name="status"]').value;
                var currentStatus = '@currentStatus';

                if (newStatus === currentStatus) {
                    e.preventDefault();
                    alert('Please select a different status to update.');
                } else {
                    var confirmMessage = 'Are you sure you want to change the status from "' + currentStatus + '" to "' + newStatus + '"?';
                    if (!confirm(confirmMessage)) {
                        e.preventDefault();
                    }
                }
            });
        }
    </script>
}