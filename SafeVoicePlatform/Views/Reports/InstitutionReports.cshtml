@model IEnumerable<SafeVoicePlatform.Models.Report>

@{
    ViewData["Title"] = "Institution Reports";
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentType = ViewBag.CurrentType as string;
    var currentFromDate = ViewBag.CurrentFromDate as string;
    var currentToDate = ViewBag.CurrentToDate as string;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Institution Reports</h1>
        <div>
           
            <a asp-action="Export" asp-route-fromDate="@currentFromDate" asp-route-toDate="@currentToDate" class="btn btn-outline-success">
                <i class="bi bi-download"></i> Export Current View
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Filters</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        @if (ViewBag.Statuses != null)
                        {
                            foreach (var status in ViewBag.Statuses)
                            {
                                var statusValue = status.Value as string;
                                var statusText = status.Text as string;
                                if (currentStatus == statusValue)
                                {
                                    <option value="@statusValue" selected>@statusText</option>
                                }
                                else
                                {
                                    <option value="@statusValue">@statusText</option>
                                }
                            }
                        }
                        else
                        {
                            <option value="">All Statuses</option>
                            <option value="Pending">Pending</option>
                            <option value="Under Review">Under Review</option>
                            <option value="Resolved">Resolved</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Report Type</label>
                    <select name="type" class="form-select">
                        <option value="">All Types</option>
                        @if (ViewBag.ReportTypes != null)
                        {
                            foreach (var type in ViewBag.ReportTypes)
                            {
                                var typeValue = type.Value as string;
                                var typeText = type.Text as string;
                                if (currentType == typeValue)
                                {
                                    <option value="@typeValue" selected>@typeText</option>
                                }
                                else
                                {
                                    <option value="@typeValue">@typeText</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@currentFromDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@currentToDate" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Apply Filters
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reports Table -->
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Urgent</th>
                            <th>Anonymous</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    No reports found matching the filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var report in Model)
                            {
                                <tr>
                                    <td>#@report.Id</td>
                                    <td>@report.ReportType</td>
                                    <td>@report.Title</td>
                                    <td>
                                        @if (report.Status == "Resolved")
                                        {
                                            <span class="badge bg-success">@report.Status</span>
                                        }
                                        else if (report.Status == "Under Review")
                                        {
                                            <span class="badge bg-warning text-dark">@report.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@report.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (report.IsUrgent)
                                        {
                                            <span class="badge bg-danger">Urgent</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (report.IsAnonymous)
                                        {
                                            <span class="badge bg-info">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No</span>
                                        }
                                    </td>
                                    <td>@report.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@report.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>