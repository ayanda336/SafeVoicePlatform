@model IEnumerable<SafeVoicePlatform.Models.Report>

@{
    ViewData["Title"] = "My Reports";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-semibold mb-0">My Reports</h1>
            <p class="text-muted small mb-0">Track the status of your submitted reports</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> New Report
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border rounded-3 bg-light">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <h5 class="mt-3 mb-2">No Reports Found</h5>
            <p class="text-muted small mb-3">You haven't submitted any reports yet.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm">Submit Your First Report</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-borderless">
                <thead class="border-bottom">
                    <tr class="small text-muted">
                        <th class="fw-normal">ID</th>
                        <th class="fw-normal">Title</th>
                        <th class="fw-normal">Type</th>
                        <th class="fw-normal">Status</th>
                        <th class="fw-normal">Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        <tr class="border-bottom">
                            <td class="py-3">#@report.Id</td>
                            <td class="py-3 fw-medium">@report.Title</td>
                            <td class="py-3 text-muted small">@report.ReportType</td>
                            <td class="py-3">
                                <span class="badge @(report.Status == "Resolved" ? "bg-success" : report.Status == "Under Review" ? "bg-warning" : "bg-secondary") px-2 py-1 fw-normal">
                                    @report.Status
                                </span>
                            </td>
                            <td class="py-3 text-muted small">@report.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="py-3 text-end">
                                <a asp-action="Details" asp-route-id="@report.Id" class="btn btn-link btn-sm text-decoration-none p-0">View →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-end small text-muted">
            Total: @Model.Count() reports
        </div>
    }
</div>