        <li class="nav-item">
            <a class="nav-link text-white fw-bold fs-6" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus fs-6 me-2"></i> Register
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white fw-bold fs-6" asp-area="Identity" asp-page="/Account/Login">
