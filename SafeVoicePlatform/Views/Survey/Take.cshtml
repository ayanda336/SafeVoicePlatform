@model SafeVoicePlatform.Models.Survey

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Survey Header -->
            <div class="mb-4">
                <h1 class="h2 fw-semibold mb-2">@Model.Title</h1>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted">@Model.Description</p>
                }
                <hr class="mt-3" />
            </div>

            <!-- Survey Form -->
            <form asp-action="Submit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="surveyId" value="@Model.Id" />

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @foreach (var question in Model.Questions!)
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label fw-semibold fs-5">
                                    @question.QuestionText
                                    @if (question.IsRequired)
                                    {
                                        <span class="text-danger ms-1">*</span>
                                    }
                                </label>
                            </div>

                            @if (question.QuestionType == "multiple_choice" && !string.IsNullOrEmpty(question.Options))
                            {
                                var options = question.Options.Split(',');
                                <div class="row g-3">
                                    @foreach (var option in options)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check border rounded-3 p-3 option-card">
                                                <input class="form-check-input" type="radio"
                                                       name="answers[@question.Id]" value="@option.Trim()"
                                                       id="q@(question.Id)_@option.Trim()"
                                                       @(question.IsRequired ? "required" : "")>
                                                <label class="form-check-label ms-2 fw-medium" for="q@(question.Id)_@option.Trim()">
                                                    @option.Trim()
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (question.QuestionType == "rating")
                            {
                                <div class="rating-container">
                                    <div class="stars-rating" id="rating_@question.Id">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <input type="radio" name="answers[@question.Id]" value="@i" id="star_@question.Id-@i" @(question.IsRequired ? "required" : "") />
                                            <label for="star_@question.Id-@i" class="star-label">
                                                <i class="bi bi-star"></i>
                                            </label>
                                        }
                                    </div>
                                    <div class="rating-labels mt-2">
                                        <span class="text-muted small">Poor</span>
                                        <span class="text-muted small">Fair</span>
                                        <span class="text-muted small">Good</span>
                                        <span class="text-muted small">Very Good</span>
                                        <span class="text-muted small">Excellent</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <textarea class="form-control" name="answers[@question.Id]" rows="4"
                                  placeholder="Please share your thoughts..."
                                  @(question.IsRequired ? "required" : "")></textarea>
                                <small class="text-muted mt-2 d-block">Your feedback is valuable to us.</small>
                            }
                        </div>
                    </div>
                }

                <!-- Anonymous Option -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isAnonymous" value="true" id="isAnonymous" checked />
                            <label class="form-check-label fw-semibold" for="isAnonymous">
                                Submit Anonymously
                            </label>
                        </div>
                        <p class="text-muted small mt-2 mb-0">
                            <i class="bi bi-shield-lock me-1"></i> Your responses will be anonymous and cannot be linked to your identity.
                        </p>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="bi bi-check-lg me-1"></i> Submit Survey
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Rating Stars */
    .rating-container {
        text-align: center;
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .stars-rating {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: center;
        gap: 0.5rem;
    }

        .stars-rating input {
            display: none;
        }

    .star-label {
        cursor: pointer;
        font-size: 2rem;
        color: #cbd5e1;
        transition: all 0.2s ease;
    }

        .star-label i {
            font-size: 2rem;
        }

    .stars-rating input:checked ~ label i,
    .stars-rating input:hover ~ label i,
    .stars-rating label:hover i {
        color: #f5b042;
    }

    .stars-rating input:checked + label i,
    .stars-rating label:hover i {
        color: #f5b042;
    }

    .stars-rating label:hover i,
    .stars-rating label:hover ~ label i {
        color: #f5b042;
    }

    .rating-labels {
        display: flex;
        justify-content: space-between;
        max-width: 280px;
        margin: 0 auto;
    }

    /* Option Cards */
    .option-card {
        transition: all 0.2s ease;
        cursor: pointer;
        background: #ffffff;
        border: 1px solid #e2e8f0;
    }

        .option-card:hover {
            background: #f8fafc;
            border-color: #0066cc;
        }

        .option-card .form-check-input:checked + .form-check-label {
            color: #0066cc;
        }

    .form-check-input:checked {
        background-color: #0066cc;
        border-color: #0066cc;
    }

    .form-check-input:focus {
        border-color: #0066cc;
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.25);
    }

    /* Card styling */
    .card {
        border-radius: 12px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .star-label i

    {
        font-size: 1.5rem;
    }

    .rating-labels {
        font-size: 0.7rem;
        max-width: 220px;
    }

    .option-card {
        padding: 0.75rem;
    }

    }
</style>

<script>
    // Ensure rating stars work properly with the reverse order
    document.addEventListener('DOMContentLoaded', function() {
        // Additional styling for selected stars
        const starContainers = document.querySelectorAll('.stars-rating');
        starContainers.forEach(container => {
            const inputs = container.querySelectorAll('input');
            inputs.forEach(input => {
                input.addEventListener('change', function() {
                    const value = this.value;
                    const labels = container.querySelectorAll('.star-label');
                    labels.forEach((label, index) => {
                        const starValue = 5 - index;
                        const starIcon = label.querySelector('i');
                        if (starValue <= value) {
                            starIcon.classList.remove('bi-star');
                            starIcon.classList.add('bi-star-fill');
                        } else {
                            starIcon.classList.remove('bi-star-fill');
                            starIcon.classList.add('bi-star');
                        }
                    });
                });
            });
        });
    });
</script>