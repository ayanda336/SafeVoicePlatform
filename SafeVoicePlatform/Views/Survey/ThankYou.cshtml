@{
    ViewData["Title"] = "Thank You";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow">
                <div class="card-body p-5">
                    <i class="bi bi-heart-fill text-success" style="font-size: 4rem;"></i>
                    <h1 class="mt-3">Thank You!</h1>
                    <p class="lead">Your feedback helps us create a safer environment for everyone.</p>
                    <p>Your voice matters and your responses are valuable to us.</p>
                    <a asp-action="Index" class="btn btn-primary mt-3">
                        <i class="bi bi-arrow-left"></i> View All Surveys
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-3 ms-2">
                        <i class="bi bi-house"></i> Go Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>